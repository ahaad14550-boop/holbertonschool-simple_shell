#!/bin/bash
# Task 11: exit with status
SHELL=./hsh
PASS=0
FAIL=0

check() {
    if [ "$1" = "$2" ]; then
        echo "PASS: $3"
        PASS=$((PASS + 1))
    else
        echo "FAIL: $3"
        echo "  GOT:      $1"
        echo "  EXPECTED: $2"
        FAIL=$((FAIL + 1))
    fi
}

echo "exit" | $SHELL 2>&1
check "$?" "0" "exit no args returns 0"

echo "exit 0" | $SHELL 2>&1
check "$?" "0" "exit 0"

echo "exit 98" | $SHELL 2>&1
check "$?" "98" "exit 98"

echo "exit 1" | $SHELL 2>&1
check "$?" "1" "exit 1"

echo "exit 255" | $SHELL 2>&1
check "$?" "255" "exit 255"

echo "PASSED: $PASS | FAILED: $FAIL"
